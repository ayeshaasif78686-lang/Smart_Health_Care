# Copy this file to backend/.env (or run: npm run setup). NEVER commit backend/.env.
#
# MongoDB Atlas: Clusters > Connect > Drivers > copy the string, replace <db_password>
# with your real database-user password (no < > brackets) and add the database name
# /smart_healthcare before the "?".
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>.mongodb.net/smart_healthcare?retryWrites=true&w=majority&appName=Cluster0
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
SEED_PASSWORD=choose_a_local_demo_password_of_at_least_10_characters
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
