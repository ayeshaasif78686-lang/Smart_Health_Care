{
  "name": "healthcare-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node scripts/seed.js",
    "test": "node --test tests/*.test.js",
    "setup": "node scripts/setup.js",
    "demo": "node scripts/demo.js",
    "db:check": "node scripts/check-db.js",
    "test:unit": "node --test tests/core.test.js tests/demo-api.test.js tests/features.test.js",
    "seed:reset": "node scripts/seed.js --reset",
    "docs:schema": "node scripts/schema-doc.js",
    "test:db": "node --test tests/db.test.js tests/api.test.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "mongoose": "^8.12.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "bcryptjs": "^3.0.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "mongodb-memory-server": "^10.1.4"
  }
}